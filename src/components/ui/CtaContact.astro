---
import Icon from '@/components/ui/Icon.astro';
import { mailHref, site, telHref, whatsappHref } from '@/config/site';

interface Props {
  title?: string;
}
const { title = '¿Hablamos de tu piscina?' } = Astro.props;
---

<section aria-labelledby="cta-titulo" class="py-20 lg:py-28">
  <div class="container-ks">
    <div class="relative overflow-hidden rounded-[2rem] bg-noche px-6 py-14 text-white sm:px-12 lg:px-16 lg:py-20" data-reveal>
      <div class="pointer-events-none absolute -bottom-32 -left-20 size-[28rem] rounded-full bg-azul/30 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow-claro flex items-center gap-3">
            <span class="teselas" style="--t:8px" aria-hidden="true"></span>
            Presupuesto sin compromiso
          </p>
          <h2 id="cta-titulo" class="mt-4 text-3xl font-semibold !text-white sm:text-4xl lg:text-5xl">{title}</h2>
          <p class="mt-5 max-w-xl text-lg text-white/80">
            Cuéntanos qué tienes en mente: una piscina nueva, una reforma o mejorar la que ya tienes. Te
            preparamos un presupuesto a medida en {site.area.locality}.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/presupuesto/" class="btn btn-cta text-lg">
              Pide presupuesto
              <Icon name="arrow" size={20} />
            </a>
            <a href={telHref} class="btn btn-claro">
              <Icon name="phone" size={20} />
              Llamar al {site.phone.display}
            </a>
          </div>
        </div>
        <ul class="space-y-5 rounded-2xl bg-white/5 p-6 ring-1 ring-white/15 sm:p-8">
          <li>
            <a href={whatsappHref} rel="noopener" target="_blank" class="flex items-center gap-4 text-white no-underline hover:underline">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-cielo"><Icon name="whatsapp" /></span>
              <span>
                <span class="block text-sm text-white/70">WhatsApp</span>
                {site.phone.display}<span class="sr-only"> (se abre en una ventana nueva)</span>
              </span>
            </a>
          </li>
          <li>
            <a href={mailHref} class="flex items-center gap-4 text-white no-underline hover:underline">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-cielo"><Icon name="mail" /></span>
              <span class="min-w-0 break-all">
                <span class="block text-sm text-white/70">Email</span>
                {site.email}
              </span>
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-cielo"><Icon name="clock" /></span>
            <span>
              <span class="block text-sm text-white/70">Horario</span>
              {site.hours.display}
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
