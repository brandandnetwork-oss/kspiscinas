---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}
const { eyebrow, title, id, align = 'left', dark = false } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {
    eyebrow && (
      <p class:list={[dark ? 'eyebrow-claro' : 'eyebrow', 'flex items-center gap-3', align === 'center' && 'justify-center']}>
        <span class="teselas" style="--t:8px" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class:list={['mt-4 text-3xl font-semibold sm:text-4xl lg:text-[2.75rem]', dark && '!text-white']}>
    {title}
  </h2>
  {
    Astro.slots.has('default') && (
      <div class:list={['mt-5 text-lg', dark ? 'text-white/80' : 'text-piedra']}>
        <slot />
      </div>
    )
  }
</div>
