---
/**
 * Visor de fotos con <dialog> nativo (foco atrapado y Escape gratis).
 * Mejora progresiva: sin JS, los enlaces [data-lightbox] abren la imagen.
 * Navega entre los enlaces visibles (respeta los filtros de la galería).
 */
---

<dialog
  id="lightbox"
  aria-label="Visor de fotos"
  class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-noche/90 backdrop:backdrop-blur-sm"
>
  <div id="lightbox-fondo" class="relative flex h-[100svh] w-screen flex-col items-center justify-center px-4 py-16 sm:px-20">
    <figure class="flex max-h-full flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[78svh] w-auto max-w-full rounded-xl object-contain shadow-lift" />
      <figcaption id="lightbox-caption" class="mt-4 text-center font-display text-white"></figcaption>
    </figure>
    <p id="lightbox-count" class="absolute top-5 left-5 font-display text-sm text-white/80" aria-live="polite"></p>
    <button type="button" data-lb="close" class="absolute top-3 right-3 inline-flex size-12 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20">
      <span class="sr-only">Cerrar visor</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <button type="button" data-lb="prev" class="absolute top-1/2 left-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 sm:left-5">
      <span class="sr-only">Foto anterior</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
    </button>
    <button type="button" data-lb="next" class="absolute top-1/2 right-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 sm:right-5">
      <span class="sr-only">Foto siguiente</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const count = document.getElementById('lightbox-count');

  if (dialog && img && caption && count && typeof dialog.showModal === 'function') {
    let items: HTMLAnchorElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const visibles = () =>
      [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')].filter((a) => a.offsetParent !== null);

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index]!;
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = a.dataset.caption ?? '';
      count.textContent = `${index + 1} de ${items.length}`;
    };

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!a) return;
      e.preventDefault();
      opener = a;
      items = visibles();
      show(items.indexOf(a));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close' || e.target === dialog || (e.target as HTMLElement).id === 'lightbox-fondo') dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    dialog.addEventListener('close', () => {
      img.src = '';
      opener?.focus();
    });
  }
</script>
