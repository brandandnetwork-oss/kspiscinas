---
/**
 * Campo de formulario con etiqueta visible, ayuda y mensaje de error enlazados
 * por aria-describedby.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'name'> {
  id: string;
  name: string;
  label: string;
  help?: string;
  as?: 'input' | 'textarea' | 'select';
  options?: string[];
}

const { id, name, label, help, as = 'input', options = [], required, class: className, ...rest } = Astro.props;
const describedBy = [help && `${id}-ayuda`, `${id}-error`].filter(Boolean).join(' ');
const base =
  'mt-2 block w-full rounded-xl border border-linea bg-white px-4 py-3 text-base text-tinta shadow-sm transition-colors placeholder:text-piedra/70 focus:border-azul focus:outline-none focus:ring-2 focus:ring-azul/40 aria-[invalid=true]:border-coral';
---

<div class={className}>
  <label for={id} class="font-display text-[0.95rem] font-semibold text-marino">
    {label}
    {required ? <span class="text-coral" aria-hidden="true"> *</span> : <span class="font-sans font-normal text-piedra"> (opcional)</span>}
  </label>
  {help && <p id={`${id}-ayuda`} class="mt-1 text-sm text-piedra">{help}</p>}
  {
    as === 'textarea' ? (
      <textarea id={id} name={name} required={required} aria-describedby={describedBy} rows={4} class={base} {...(rest as HTMLAttributes<'textarea'>)} />
    ) : as === 'select' ? (
      <select id={id} name={name} required={required} aria-describedby={describedBy} class={base}>
        <option value="">Selecciona una opción</option>
        {options.map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input id={id} name={name} required={required} aria-describedby={describedBy} class={base} {...rest} />
    )
  }
  <p id={`${id}-error`} class="field-error mt-1.5 hidden text-sm font-medium text-coral-oscuro" role="alert"></p>
</div>
