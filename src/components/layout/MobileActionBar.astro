---
/** Barra de acción fija en móvil: llamar, WhatsApp y presupuesto siempre a un toque. */
import Icon from '@/components/ui/Icon.astro';
import { telHref, whatsappHref } from '@/config/site';
---

<nav
  aria-label="Contacto rápido"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-linea bg-white/97 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-12px_rgb(19_24_74/0.25)] backdrop-blur-md lg:hidden"
>
  <ul class="grid grid-cols-[1fr_1fr_1.4fr] gap-2 p-2">
    <li>
      <a href={telHref} class="flex h-12 flex-col items-center justify-center rounded-xl font-display text-xs font-semibold text-marino no-underline hover:bg-espuma">
        <Icon name="phone" size={20} />
        Llamar
      </a>
    </li>
    <li>
      <a href={whatsappHref} rel="noopener" target="_blank" class="flex h-12 flex-col items-center justify-center rounded-xl font-display text-xs font-semibold text-marino no-underline hover:bg-espuma">
        <Icon name="whatsapp" size={20} />
        WhatsApp<span class="sr-only"> (se abre en una ventana nueva)</span>
      </a>
    </li>
    <li>
      <a href="/presupuesto/" class="flex h-12 items-center justify-center rounded-xl bg-coral font-display text-sm font-semibold text-white no-underline hover:bg-coral-oscuro">
        Pide presupuesto
      </a>
    </li>
  </ul>
</nav>
