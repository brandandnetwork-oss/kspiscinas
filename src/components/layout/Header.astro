---
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { mainNav, site, telHref } from '@/config/site';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header
  id="cabecera"
  class="sticky top-0 z-40 border-b border-transparent bg-white/95 backdrop-blur-md transition-[border-color,box-shadow] duration-300 data-[scrolled]:border-linea data-[scrolled]:shadow-card"
>
  <div class="container-ks flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href="/" class="shrink-0 rounded" aria-label="KS Piscinas, ir al inicio">
      <Logo height={56} eager class="h-11 w-auto lg:h-14" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-3.5 py-2 font-display text-[0.95rem] font-medium text-tinta no-underline transition-colors hover:bg-espuma hover:text-marino aria-[current=page]:text-marino aria-[current=page]:bg-espuma"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={telHref}
        class="hidden items-center gap-2 rounded-full px-3 py-2 font-display font-semibold text-marino no-underline hover:bg-espuma md:inline-flex"
      >
        <Icon name="phone" size={18} />
        <span>{site.phone.display}</span>
      </a>
      <a href="/presupuesto/" class="btn btn-cta hidden !min-h-11 !px-5 !py-2 sm:inline-flex">
        Pide presupuesto
      </a>
      <button
        type="button"
        id="menu-boton"
        class="inline-flex size-11 items-center justify-center rounded-full text-marino hover:bg-espuma lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="sr-only">Abrir menú</span>
        <Icon name="menu" size={24} class="menu-abrir" />
        <Icon name="close" size={24} class="menu-cerrar hidden" />
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label="Principal (móvil)"
    class="hidden border-t border-linea bg-white lg:hidden"
  >
    <ul class="container-ks flex flex-col py-3">
      {
        mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex items-center justify-between border-b border-linea/70 py-4 font-display text-lg font-medium text-tinta no-underline aria-[current=page]:text-marino"
            >
              {item.label}
              <Icon name="arrow" size={18} class="text-azul" />
            </a>
          </li>
        ))
      }
      <li class="pt-4">
        <a href="/presupuesto/" class="btn btn-cta w-full">Pide presupuesto</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('cabecera');
  const boton = document.getElementById('menu-boton');
  const menu = document.getElementById('menu-movil');

  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (boton && menu) {
    const setOpen = (open: boolean) => {
      boton.setAttribute('aria-expanded', String(open));
      boton.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      boton.querySelector('.menu-abrir')?.classList.toggle('hidden', open);
      boton.querySelector('.menu-cerrar')?.classList.toggle('hidden', !open);
      menu.classList.toggle('hidden', !open);
    };
    boton.addEventListener('click', () => setOpen(boton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        boton.focus();
      }
    });
  }
</script>
