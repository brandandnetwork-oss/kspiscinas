---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
---

<section aria-labelledby="servicios-titulo" class="py-20 lg:py-28">
  <div class="container-ks">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="Qué hacemos" title="De la excavación a la puesta en marcha" id="servicios-titulo">
        Construimos piscinas nuevas, rehabilitamos las que ya tienes y cuidamos el espacio que las rodea.
      </SectionHeading>
      <a href="/servicios/" class="btn btn-borde shrink-0 self-start lg:self-auto" data-reveal>
        Todos los servicios
        <Icon name="arrow" size={18} />
      </a>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        servicios.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] bg-white shadow-card ring-1 ring-linea transition-shadow duration-300 hover:shadow-lift">
              <div class="aspect-[16/10] overflow-hidden sm:aspect-[4/3]">
                <Picture
                  src={s.data.image}
                  formats={['avif', 'webp']}
                  widths={[360, 540, 720]}
                  sizes="(min-width: 1280px) 290px, (min-width: 1024px) 23vw, (min-width: 640px) 46vw, 92vw"
                  alt={s.data.imageAlt}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-agua)] group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-semibold">
                  <a href={`/servicios/${s.id}/`} class="text-marino no-underline after:absolute after:inset-0 after:content-['']">
                    {s.data.navLabel}
                  </a>
                </h3>
                <p class="mt-3 text-[0.98rem] text-piedra">{s.data.summary}</p>
                <span class="mt-auto inline-flex items-center gap-2 pt-5 font-display text-sm font-semibold text-azul-texto" aria-hidden="true">
                  Ver servicio
                  <Icon name="arrow" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
