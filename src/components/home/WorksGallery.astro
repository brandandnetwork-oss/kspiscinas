---
import { Picture } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { obrasDestacadas } from '@/data/obras';
import { site } from '@/config/site';

const spans = [
  'col-span-2 row-span-2 lg:col-span-2 lg:row-span-2',
  'col-span-1',
  'col-span-1',
  'col-span-1',
  'col-span-1',
];
---

<section aria-labelledby="obras-titulo" class="bg-arena py-20 lg:py-28">
  <div class="container-ks">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="Nuestras piscinas" title="Obras reales, no fotos de catálogo" id="obras-titulo">
        Cada piscina que ves aquí la hemos construido o reformado nosotros.
      </SectionHeading>
      <div class="flex flex-wrap gap-3" data-reveal>
        <a href="/proyectos/" class="btn btn-primario">
          Ver proyectos
          <Icon name="arrow" size={18} />
        </a>
        <a href={site.social.instagram} rel="noopener" target="_blank" class="btn btn-borde">
          <Icon name="instagram" size={18} />
          {site.social.instagramHandle}<span class="sr-only"> en Instagram (se abre en una ventana nueva)</span>
        </a>
      </div>
    </div>

    <ul class="mt-14 grid auto-rows-[11rem] grid-cols-2 gap-3 sm:auto-rows-[14rem] sm:gap-4 lg:auto-rows-[16.5rem] lg:grid-cols-4">
      {
        obrasDestacadas.map((o, i) => (
          <li class:list={['group relative overflow-hidden rounded-[var(--radius-card)] bg-marino', spans[i]]} data-reveal style={`--reveal-delay:${i}`}>
            <figure class="h-full">
              <Picture
                src={o.image}
                formats={['avif', 'webp']}
                widths={i === 0 ? [480, 720, 960, 1280] : [320, 480, 640]}
                sizes={i === 0 ? '(min-width: 1280px) 620px, (min-width: 1024px) 48vw, 92vw' : '(min-width: 1280px) 300px, (min-width: 1024px) 23vw, 46vw'}
                alt={o.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-agua)] group-hover:scale-105"
              />
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-noche/90 to-transparent px-4 pt-10 pb-3 font-display text-sm font-medium text-white sm:text-base">
                {o.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
