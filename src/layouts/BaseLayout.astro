---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import Seo from '@/components/seo/Seo.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileActionBar from '@/components/layout/MobileActionBar.astro';
import { businessSchema, graph, websiteSchema } from '@/lib/schema';
import logo from '@/assets/marca/logo-ks-piscinas.png';
import ogDefault from '@/assets/obras/piscina-obra-gresite-azul-jardin.jpg';

interface Props {
  title: string;
  description: string;
  /** Imagen social; por defecto, la piscina del hero de la home. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Nodos JSON-LD específicos de la página (se añaden al @graph global). */
  schema?: object[];
}

const {
  title,
  description,
  ogImage = ogDefault,
  ogImageAlt = 'Piscina de obra con revestimiento de gresite azul construida por KS Piscinas',
  noindex,
  type,
  schema = [],
} = Astro.props;

const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const logoImg = await getImage({ src: logo, width: 600, format: 'png' });
const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <link rel="preload" href="/fonts/sora-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <Seo
      title={title}
      description={description}
      image={abs(og.src)}
      imageAlt={ogImageAlt}
      noindex={noindex}
      type={type}
    />
    <meta name="theme-color" content="#1f2b78" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd data={graph(businessSchema(abs(logoImg.src), abs(og.src)), websiteSchema(), ...schema)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only z-50 rounded-full bg-marino px-5 py-3 font-display font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />

    <script>
      // Revelado al hacer scroll: solo transform/opacity; el CSS lo anula con
      // prefers-reduced-motion y el contenido es visible si JS no se ejecuta.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
