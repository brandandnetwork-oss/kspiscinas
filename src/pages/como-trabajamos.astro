---
/**
 * Proceso de obra. [PENDIENTE] plazos orientativos por fase y condiciones de
 * garantía: añadirlos en `fases[].plazo` y en la sección de compromisos
 * cuando KS los confirme.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import CtaContact from '@/components/ui/CtaContact.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { breadcrumbSchema, type Crumb } from '@/lib/schema';
import cabecera from '@/assets/obras/canal-de-nado-gresite.jpg';

const crumbs: Crumb[] = [
  { name: 'Inicio', href: '/' },
  { name: 'Cómo trabajamos', href: '/como-trabajamos/' },
];

const fases: { title: string; text: string; puntos: string[]; plazo?: string }[] = [
  {
    title: 'Contacto y visita',
    text: 'Nos cuentas qué tienes en mente por teléfono, WhatsApp o desde la web. Después vemos el espacio para entender el terreno, los accesos y lo que necesitas.',
    puntos: ['Escuchamos tu idea y tu forma de usar la piscina', 'Revisamos el terreno y los accesos para la maquinaria'],
  },
  {
    title: 'Diseño y presupuesto',
    text: 'Te proponemos la piscina: forma, medidas, escaleras o bancos, revestimiento, coronación y equipamiento. Lo recogemos en un presupuesto detallado y sin compromiso.',
    puntos: ['Elección de gresite o porcelánico', 'Equipamiento opcional: LED, chorros, cascadas…', 'Presupuesto sin compromiso'],
  },
  {
    title: 'Excavación',
    text: 'Replanteamos la piscina sobre el terreno y excavamos el vaso con las medidas y profundidades acordadas.',
    puntos: ['Replanteo sobre el terreno', 'Excavación y preparación de la base'],
  },
  {
    title: 'Estructura gunitada',
    text: 'Colocamos la armadura de acero y proyectamos el hormigón a presión (gunitado). Así se forma un vaso continuo, sin juntas y estanco.',
    puntos: ['Armado de acero', 'Proyección del hormigón (gunitado)', 'Instalaciones de depuración'],
  },
  {
    title: 'Revestimiento y coronación',
    text: 'Revestimos el vaso con gresite o porcelánico, cuidando juntas, escaleras y esquinas, y colocamos la coronación.',
    puntos: ['Gresite o porcelánico', 'Coronación y remates', 'Equipamiento: iluminación LED, chorros…'],
  },
  {
    title: 'Llenado y puesta en marcha',
    text: 'Llenamos la piscina, ponemos en marcha la depuración y te explicamos cómo funciona todo. Y no desaparecemos: puedes contactarnos siempre que lo necesites.',
    puntos: ['Puesta en marcha de la depuración', 'Explicación del funcionamiento', 'Seguimos a tu disposición'],
  },
];

const compromisos: { icon: IconName; title: string; text: string }[] = [
  { icon: 'handshake', title: 'Presupuesto sin compromiso', text: 'Te damos un presupuesto claro antes de empezar, sin ninguna obligación.' },
  { icon: 'shield', title: 'Un único equipo', text: 'Nos encargamos de toda la obra, de la excavación a la puesta en marcha.' },
  { icon: 'drop', title: 'Depuración incluida', text: 'Todas nuestras piscinas se entregan con su sistema de depuración.' },
  { icon: 'phone', title: 'Después de la obra', text: 'No desaparecemos al terminar: seguimos a tu disposición para lo que necesites.' },
];
---

<BaseLayout
  title="Cómo construimos tu piscina: fases de obra | KS Piscinas"
  description="Así construimos tu piscina de obra en Madrid: visita, diseño y presupuesto, excavación, estructura gunitada, revestimiento y puesta en marcha. Paso a paso."
  ogImage={cabecera}
  ogImageAlt="Canal de nado de obra revestido de gresite antes del llenado"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader
    title="Cómo construimos tu piscina"
    eyebrow="Proceso de obra"
    crumbs={crumbs}
    image={cabecera}
    imageAlt="Canal de nado de obra revestido de gresite azul claro con escalera, antes del llenado"
  >
    Un proceso claro, con un único equipo de principio a fin. Esto es lo que pasa desde que nos llamas
    hasta que te bañas.
  </PageHeader>

  <section aria-labelledby="fases-titulo" class="py-20 lg:py-28">
    <div class="container-ks max-w-5xl">
      <h2 id="fases-titulo" class="text-3xl font-semibold sm:text-4xl" data-reveal>Las fases de la obra</h2>

      <ol id="timeline" class="relative mt-14">
        <!-- Línea base y progreso (se rellena al hacer scroll) -->
        <span class="absolute top-0 bottom-0 left-6 w-0.5 -translate-x-1/2 bg-linea sm:left-1/2" aria-hidden="true"></span>
        <span
          id="timeline-progreso"
          class="absolute top-0 left-6 h-full w-0.5 origin-top -translate-x-1/2 bg-gradient-to-b from-azul to-marino sm:left-1/2"
          style="transform: scaleY(0)"
          aria-hidden="true"></span>

        {
          fases.map((f, i) => (
            <li class="timeline-paso relative grid gap-6 pb-14 pl-20 last:pb-0 sm:grid-cols-2 sm:gap-16 sm:pl-0" data-reveal>
              <span class="timeline-num absolute top-0 left-6 z-10 flex size-12 -translate-x-1/2 items-center justify-center rounded-full bg-white font-display text-lg font-semibold text-marino ring-2 ring-linea transition-colors duration-500 sm:left-1/2">
                {i + 1}
              </span>
              <div class:list={['sm:pt-1', i % 2 === 0 ? 'sm:pr-12 sm:text-right' : 'sm:col-start-2 sm:pl-12']}>
                <p class="eyebrow">Fase {i + 1}</p>
                <h3 class="mt-2 text-2xl font-semibold">{f.title}</h3>
                <p class="mt-3 text-piedra">{f.text}</p>
                <ul class:list={['mt-4 space-y-2 text-[0.98rem]', i % 2 === 0 && 'sm:flex sm:flex-col sm:items-end']}>
                  {f.puntos.map((p) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" size={18} class="mt-1 shrink-0 text-azul-texto" />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="compromisos-titulo" class="bg-marino py-20 text-white lg:py-28">
    <div class="container-ks">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow-claro">Nuestro compromiso</p>
        <h2 id="compromisos-titulo" class="mt-3 text-3xl font-semibold !text-white sm:text-4xl">Lo que puedes esperar de nosotros</h2>
      </div>
      <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          compromisos.map((c, i) => (
            <li class="rounded-[var(--radius-card)] bg-white/5 p-7 ring-1 ring-white/15" data-reveal style={`--reveal-delay:${i}`}>
              <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-white/10 text-cielo">
                <Icon name={c.icon} size={24} />
              </span>
              <h3 class="mt-5 text-xl font-semibold !text-white">{c.title}</h3>
              <p class="mt-2 text-white/80">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaContact title="¿Empezamos por la visita?" />
</BaseLayout>

<style>
  .timeline-paso.is-activo .timeline-num {
    background: var(--color-marino);
    color: white;
    --tw-ring-color: var(--color-azul);
  }
</style>

<script>
  // Progreso de la línea de tiempo: escala (transform) según el scroll y marca
  // las fases ya alcanzadas. Sin JS, la lista se lee igual.
  const ol = document.getElementById('timeline');
  const barra = document.getElementById('timeline-progreso');
  const pasos = [...document.querySelectorAll<HTMLElement>('.timeline-paso')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ol && barra) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = ol.getBoundingClientRect();
      const mid = innerHeight * 0.55;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      barra.style.transform = `scaleY(${reduce ? (p > 0 ? 1 : 0) : p})`;
      for (const paso of pasos) paso.classList.toggle('is-activo', paso.getBoundingClientRect().top < mid);
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
