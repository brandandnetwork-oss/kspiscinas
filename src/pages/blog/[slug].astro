---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import CtaContact from '@/components/ui/CtaContact.astro';
import Icon from '@/components/ui/Icon.astro';
import { articleSchema, breadcrumbSchema, type Crumb } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const path = `/blog/${post.id}/`;

const servicios = await getCollection('servicios', (s) => data.servicios.includes(s.id));
const otros = (await getCollection('blog', (p) => !p.data.draft && p.id !== post.id)).slice(0, 2);
const img = await getImage({ src: data.image, width: 1200, format: 'jpg' });
const fecha = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const indice = headings.filter((h) => h.depth === 2);

const crumbs: Crumb[] = [
  { name: 'Inicio', href: '/' },
  { name: 'Guías', href: '/blog/' },
  { name: data.title, href: path },
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogImage={data.image}
  ogImageAlt={data.imageAlt}
  type="article"
  schema={[
    breadcrumbSchema(crumbs),
    articleSchema({
      headline: data.title,
      description: data.description,
      path,
      image: new URL(img.src, Astro.site).href,
      datePublished: data.datePublished,
      dateModified: data.dateModified,
    }),
  ]}
>
  <article>
    <header class="bg-espuma">
      <div class="container-ks max-w-4xl pt-12 pb-10 sm:pt-16">
        <Breadcrumbs items={crumbs} />
        <h1 class="mt-8 text-4xl font-semibold sm:text-5xl">{data.title}</h1>
        <p class="mt-5 text-lg text-piedra sm:text-xl">{data.description}</p>
        <p class="mt-6 text-sm text-piedra">
          Por KS Piscinas · <time datetime={data.datePublished.toISOString()}>{fecha(data.datePublished)}</time>
          {
            data.dateModified && (
              <>
                {' '}· Actualizado el <time datetime={data.dateModified.toISOString()}>{fecha(data.dateModified)}</time>
              </>
            )
          }
        </p>
      </div>
    </header>

    <div class="container-ks max-w-4xl">
      <Picture
        src={data.image}
        formats={['avif', 'webp']}
        widths={[480, 768, 1024, 1400]}
        sizes="(min-width: 1024px) 832px, 92vw"
        alt={data.imageAlt}
        loading="eager"
        fetchpriority="high"
        class="-mt-2 aspect-[16/9] w-full rounded-[2rem] object-cover shadow-card"
      />
    </div>

    <div class="container-ks grid max-w-6xl gap-12 py-14 lg:grid-cols-[1fr_16rem] lg:gap-16 lg:py-20">
      <div class="prose-ks mx-auto w-full max-w-3xl">
        <Content />
      </div>

      <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
        {
          indice.length > 2 && (
            <nav aria-labelledby="indice-titulo" class="hidden lg:block">
              <h2 id="indice-titulo" class="font-display text-sm font-semibold tracking-[0.12em] text-marino uppercase">En esta guía</h2>
              <ol class="mt-4 space-y-2 border-l-2 border-linea text-[0.95rem]">
                {indice.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="-ml-0.5 block border-l-2 border-transparent pl-4 text-piedra no-underline hover:border-azul hover:text-marino">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          servicios.length > 0 && (
            <div class="rounded-[var(--radius-card)] bg-espuma p-6">
              <h2 class="font-display text-sm font-semibold tracking-[0.12em] text-marino uppercase">Servicios relacionados</h2>
              <ul class="mt-4 space-y-2">
                {servicios.map((s) => (
                  <li>
                    <a href={`/servicios/${s.id}/`} class="inline-flex items-center gap-2 font-medium">
                      {s.data.navLabel} <Icon name="arrow" size={16} />
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/presupuesto/" class="btn btn-cta mt-6 w-full !min-h-11 !py-2 text-sm">Pide presupuesto</a>
            </div>
          )
        }
      </aside>
    </div>
  </article>

  {
    otros.length > 0 && (
      <section aria-labelledby="mas-guias" class="bg-arena py-16">
        <div class="container-ks max-w-6xl">
          <h2 id="mas-guias" class="text-2xl font-semibold sm:text-3xl">Más guías</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-2">
            {otros.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`} class="group flex h-full items-center justify-between gap-4 rounded-[var(--radius-card)] bg-white p-6 no-underline shadow-card ring-1 ring-linea hover:shadow-lift">
                  <span class="font-display text-lg font-semibold text-marino">{p.data.title}</span>
                  <Icon name="arrow" size={20} class="shrink-0 text-azul transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaContact />
</BaseLayout>
