# KS Piscinas — Hostinger (Apache/LiteSpeed)
# Redirecciones de la web antigua (WordPress), HTTPS canónico, caché y seguridad.

Options -Indexes
ErrorDocument 404 /404.html
DirectorySlash On

<IfModule mod_rewrite.c>
RewriteEngine On

# ── 1. Dominio canónico en un solo salto: https://kspiscinas.es (sin www) ──
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kspiscinas.es/$1 [R=301,L,NE]

# ── 2. URLs antiguas de WordPress → nuevas (301) ──
RewriteRule ^incio/?$ / [R=301,L]
RewriteRule ^que-hacemos/?$ /servicios/ [R=301,L]
RewriteRule ^galeria/?$ /proyectos/ [R=301,L]
RewriteRule ^contactanos/?$ /presupuesto/ [R=301,L]
RewriteRule ^pagina-en-mantencion/?$ / [R=301,L]
RewriteRule ^politica-de-cookies-ue/?$ /politica-de-cookies/ [R=301,L]
RewriteRule ^feed/?$ /blog/ [R=301,L]
RewriteRule ^(sitemap\.xml|wp-sitemap.*\.xml|sitemap_index\.xml)$ /sitemap-index.xml [R=301,L]

# Fotos de la galería antigua → página de proyectos (conserva tráfico de Google Imágenes)
RewriteRule ^wp-content/uploads/.*\.(jpe?g|png|webp)$ /proyectos/ [R=301,L,NC]

# ── 3. Contenido eliminado (410 Gone) ──
# Archivo de autor que exponía un email personal, feeds vacíos y rutas de WordPress.
RewriteCond %{QUERY_STRING} (^|&)author= [NC]
RewriteRule ^ - [G,L]
RewriteRule ^author/ - [G,L]
RewriteRule ^comments/feed/?$ - [G,L]
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G,L]

# ── 4. Barra final en las páginas (evita contenido duplicado) ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5})$ [NC]
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# ── Cabeceras de seguridad ──
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Compresión ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caché: recursos con hash (/_astro/) 1 año; fuentes 1 año; HTML sin caché larga ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^_astro/|\.(woff2|avif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Protege la configuración del formulario
<Files "config.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>
